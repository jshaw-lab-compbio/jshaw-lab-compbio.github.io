source "https://rubygems.org"

# This is the same gem GitHub Pages uses to build your site server-side,
# so what you see locally (`bundle exec jekyll serve`) matches what gets
# published — no separate build step or CI config needed.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows/WSL sometimes needs these explicitly
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
gem "webrick"
